# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=your_database_url

# Encryption
ENCRYPTION_KEY=your_encryption_key

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key

# Stripe (Optional - for payments)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@archonpro.nl
SMTP_FROM_NAME=ArchonPro

# Cron Job Security
CRON_SECRET=your_secure_random_string_for_cron_auth

# Environment
NODE_ENV=production
NEXT_PUBLIC_E2E=false

# Gemini AI (verplicht voor AI assistant)
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp Business API (voor document versturen via WhatsApp)
WHATSAPP_BUSINESS_ID=your_whatsapp_business_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Telegram Bot (voor support chat)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id

# Site URL voor Stripe redirect
NEXT_PUBLIC_SITE_URL=https://your-domain.com
