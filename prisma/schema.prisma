// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  language  String   @default("nl")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  settings UserSettings?
}

// User-specific settings for SaaS multi-tenant
model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Company info
  companyName String?
  companyLogo String? // URL to logo

  // SMTP Configuration (per user)
  smtpProvider   String? // "gmail", "outlook", "custom"
  smtpGmailUser  String?
  smtpGmailPassword String? // Encrypted
  smtpOutlookUser String?
  smtpOutlookPassword String? // Encrypted
  smtpCustomHost String?
  smtpCustomPort Int?
  smtpCustomUser String?
  smtpCustomPassword String? // Encrypted
  smtpCustomFrom String?
  emailFromName  String?
  emailFromAddress String?

  // Stripe Configuration (per user)
  stripePublishableKey String?
  stripeSecretKey      String? // Encrypted
  stripeWebhookSecret  String?
  stripeTestMode       Boolean @default(true)

  // Notification Preferences
  notifyEmailNewDeal    Boolean @default(true)
  notifyEmailInvoice    Boolean @default(true)
  notifyEmailWeekly     Boolean @default(true)
  notifyEmailMarketing  Boolean @default(false)
  notifyPushAppointment Boolean @default(true)
  notifyPushTask        Boolean @default(false)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  location    String?
  website     String?
  phone       String?
  email       String?
  vatNumber   String?
  description String?
  status      String   @default("Actief") // Actief, Inactief, Nieuw
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contacts Contact[]
  deals    Deal[]
  quotes   Quote[]
  projects Project[]
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  companyId String?
  tags      String? // JSON string of tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
}

model Deal {
  id          String   @id @default(cuid())
  name        String
  companyId   String?
  value       Float?
  priority    String   @default("medium") // hoog, medium, laag
  probability Int      @default(0) // 0-100
  status      String   @default("nieuw") // nieuw, contact, offerte, onderhandeling, gewonnen, verloren
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
  quotes  Quote[]
}

model Quote {
  id        String   @id @default(cuid())
  number    String   @unique
  title     String
  companyId String?
  dealId    String?  @unique
  amount    Float?
  status    String   @default("concept") // concept, verstuurd, geaccepteerd, geweigerd
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  companyId   String?
  status      String    @default("nieuw") // nieuw, actief, afgerond, gepauzeerd
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  type        String? // meeting, call, deadline, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Discussion {
  id        String   @id @default(cuid())
  title     String
  message   String
  authorId  String?
  category  String   @default("general") // general, project, support, announcement
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages DiscussionMessage[]
}

model DiscussionMessage {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String?
  message      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  discussion Discussion @relation(fields: [discussionId], references: [id])
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  customer      String
  customerEmail String?
  amount        Float
  vatAmount     Float     @default(0)
  totalAmount   Float
  date          DateTime  @default(now())
  dueDate       DateTime
  status        String    @default("Concept") // Concept, Verzonden, Openstaand, Achterstallig, Betaald, Gecrediteerd, Geannuleerd
  paidAt        DateTime?
  paymentMethod String?
  items         String // JSON array of invoice items
  timeline      String // JSON array of timeline events
  remindersSent Int       @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("invoices")
}

model Module {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  price         Float
  stripePriceId String?  // Gekoppeld aan Stripe Price ID
  features      String   // JSON array of feature strings
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  subscriptions Subscription[]
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  moduleId  String
  status    String    @default("active") // active, cancelled, expired
  startDate DateTime  @default(now())
  endDate   DateTime?
  amount    Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  module Module @relation(fields: [moduleId], references: [id])

  @@index([userId])
  @@index([moduleId])
}

// Communication Templates for Email, WhatsApp, Telegram
model CommunicationTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String   // email, whatsapp, telegram
  subject   String?  // Only for email
  content   String
  variables String   // JSON array of variable names
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("communication_templates")
}

// Message Queue for background sending
model MessageQueue {
  id           String    @id @default(cuid())
  userId       String?
  recipient    String    // email, phone number, or telegram chat id
  channel      String    // email, whatsapp, telegram
  templateId   String?
  subject      String?
  content      String
  variables    String?   // JSON object with variable values
  status       String    @default("pending") // pending, processing, sent, failed
  priority     Int       @default(0) // higher = more urgent
  scheduledAt  DateTime?
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([channel])
  @@index([scheduledAt])
  @@map("message_queue")
}

// Communication Logs for tracking all sent messages
model CommunicationLog {
  id           String   @id @default(cuid())
  userId       String?
  recipient    String
  channel      String   // email, whatsapp, telegram
  templateId   String?
  subject      String?
  content      String
  status       String   // sent, delivered, read, failed, bounced
  externalId   String?  // Message ID from provider (WhatsApp, Telegram, etc.)
  sentAt       DateTime @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  metadata     String?  // JSON for additional data
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([channel])
  @@index([sentAt])
  @@map("communication_logs")
}

// Discount Codes for SaaS
model DiscountCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // percentage, fixed
  discountValue Float
  validFrom     DateTime @default(now())
  validUntil    DateTime
  maxUses       Int      @default(100)
  usageCount    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("discount_codes")
}

// Support Tickets
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  subject     String
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("medium") // low, medium, high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  messages SupportTicketMessage[]

  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String?  // null = system/admin
  sender    String   // user, admin, system
  message   String
  isInternal Boolean @default(false) // internal note not visible to user
  createdAt DateTime @default(now())

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// System Notifications for platform-wide banners
model SystemNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  isActive  Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("system_notifications")
}

// Subscription Plans (SaaS pricing)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  price           Float
  interval        String   @default("month") // month, year
  features        String   // JSON array of features
  modules         String   // JSON array of module slugs
  isActive        Boolean  @default(true)
  subscriberCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscription_plans")
}

// Payments tracking
model Payment {
  id           String    @id @default(cuid())
  userId       String
  userEmail    String
  amount       Float
  currency     String    @default("EUR")
  status       String    @default("pending") // pending, paid, failed, refunded
  method       String    // stripe, mollie, invoice
  externalId   String?   // Payment ID from provider
  invoiceUrl   String?
  paidAt       DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

